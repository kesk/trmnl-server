[Unit]
# Second, independent instance of the forecast server, for rehearsing a change against a
# real display before it touches the one on the wall. Shares nothing with trmnl-server.service
# but the host: its own working directory (so its own devices.edn, archive/ and logs/),
# its own port, its own unit.
Description=TRMNL forecast server (test instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seb
WorkingDirectory=/home/seb/trmnl-server-test
Environment=PORT=8081
# Server-wide default only. Each display's location — and, if it wants one, its own
# hour count — lives in /home/seb/trmnl-server-test/devices.edn.
Environment=FORECAST_HOURS=23
# Its own admin password, like everything else about this instance. Optional (`-`):
# without the file the pages are open. See deploy/admin.env.example.
EnvironmentFile=-/home/seb/trmnl-server-test/admin.env
# Require the login only for requests arriving from the internet. The home network is
# exempt, which is also what keeps the password off the LAN: the only place it is ever
# typed is the https tunnel. Judged by the TCP peer address, never by a header — and
# note loopback is NOT exempt, because that is where cloudflared's traffic arrives from.
Environment=ADMIN_TRUST_LAN=true
# Refuse to accept a password over an unencrypted connection (loopback excepted, so
# local development still works). On by default; here for visibility.
Environment=ADMIN_REQUIRE_TLS_LOGIN=true
ExecStart=/usr/bin/java -jar /home/seb/trmnl-server-test/trmnl-server.jar --serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
