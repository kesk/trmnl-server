[Unit]
Description=TRMNL forecast server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seb
WorkingDirectory=/home/seb/trmnl-server
# Server-wide default only. Each display's location — and, if it wants one, its own
# hour count — lives in ~/trmnl-server/devices.edn.
Environment=FORECAST_HOURS=23
ExecStart=/usr/bin/java -jar /home/seb/trmnl-server/trmnl-server.jar --serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
