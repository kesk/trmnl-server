;; Device registry — copy to devices.edn and edit. Read once at startup, so restart
;; the service after changing it. Override the path with $DEVICES_FILE.
;;
;; Keyed by the device's MAC address, which the TRMNL firmware sends as the `ID`
;; header on every request. Case doesn't matter. Don't know the MAC yet? Point the
;; device at this server: it will show its own MAC on its own screen, ready to copy
;; in here.
;;
;;   :id     required, [a-z0-9-]+, unique. The display's permanent identity: it's the
;;           URL segment (/images/<id>/…, /devices/<id>/…) and the directory name
;;           (archive/<id>/, logs/<id>/), so it's validated strictly at load. Pick one
;;           and never change it — changing an :id moves that display's archive and
;;           telemetry directories and breaks every existing link to it. Rename the
;;           :name instead; that's what it's for.
;;   :name   required. The label shown on the web pages, and nothing else — free-form,
;;           so "Hallway" or "Pappas kök" are both fine. Change it whenever you like.
;;   :lat    required, decimal degrees.
;;   :lon    required, decimal degrees.
;;   :token  required. Handed to the device by /api/setup as its api_key, and
;;           checked against the Access-Token header on every later request.
;;           Any long random string will do: `head -c 24 /dev/urandom | base64`
;;   :hours  optional. How many hourly points to render; falls back to
;;           $FORECAST_HOURS, then to core/default-forecast-hours (23).

{"AA:BB:CC:DD:EE:FF" {:id    "hallway"
                      :name  "Hallway"
                      :lat   57.715722
                      :lon   12.035778
                      :token "replace-me-with-something-random"}

 "11:22:33:44:55:66" {:id    "pappa"
                      :name  "Pappa"
                      :lat   57.6667
                      :lon   12.85
                      :token "replace-me-too"
                      :hours 23}}
